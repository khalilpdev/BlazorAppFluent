    private void SelectChat(Chat chat)
    {
        selectedChat = chat;
        chat.UnreadCount = 0;
        chats.ForEach(c => c.IsActive = false);
        chat.IsActive = true;
    }

    private void DeselectChat() { selectedChat = null; chats.ForEach(c => c.IsActive = false); }
    private void SetActiveTab(string tab) { activeTab = tab; }

    public class Chat
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string LastMessage { get; set; } = string.Empty;
        public string LastMessageTime { get; set; } = string.Empty;
        public MessageType LastMessageType { get; set; }
        public int UnreadCount { get; set; }
        public bool IsActive { get; set; }
        public List<Message> Messages { get; set; } = new();
    }

    public class Message { public string Content { get; set; } = string.Empty; public string Time { get; set; } = string.Empty; public bool IsMine { get; set; } }
    public enum MessageType { Text, Voice, Link }
}

<style>
    /* MAIN Container */
    .whatsapp-container {
        display: flex;
        height: 100vh;
        width: 100%;
        background-color: var(--neutral-layer-1);
        font-family: 'Segoe UI', system-ui, sans-serif;
        overflow: hidden;
    }

    /* left column  */
    .chats-area {
        display: flex;
        flex-direction: column; /* Vertical: Header -> Busca -> Lista -> Menu */
        width: 350px;
        min-width: 350px; /* fixed length on desktop */
        height: 100%;
        border-right: 1px solid var(--neutral-stroke-divider-rest);
        background-color: var(--neutral-layer-1);
    }

    .header { padding: 16px; background-color: var(--neutral-layer-1); }
    .search-bar { padding: 8px 16px; background-color: var(--neutral-layer-1); }
    .filter-tabs { padding: 0 16px; border-bottom: 1px solid var(--neutral-stroke-rest); }

    .conversations-list {
        flex: 1; 
        overflow-y: auto;
        min-height: 0; 
    }

    /* right column - content */
    .main-content-area {
        flex: 1;
        display: flex;
        flex-direction: column;
        background-color: var(--neutral-layer-2);
        height: 100%;
        overflow: hidden;
    }

    /* chat components */
    .chat-item {
        cursor: pointer;
        border-bottom: 1px solid var(--neutral-stroke-rest);
        transition: background-color 0.2s;
        padding: 12px 16px;
    }
    .chat-item:hover { background-color: var(--neutral-layer-3); }
    .active-chat { background-color: var(--accent-fill-rest); color: white; }
    .active-chat .chat-name, .active-chat .chat-time, .active-chat .message-preview { color: white; }
    
    .chat-content { display: flex; align-items: flex-start; gap: 12px; }
    .chat-avatar { flex-shrink: 0; }
    .avatar-placeholder {
        width: 48px; height: 48px; border-radius: 50%;
        background-color: var(--accent-fill-rest);
        display: flex; align-items: center; justify-content: center; color: white;
    }
    .chat-details { flex: 1; min-width: 0; }
    .chat-header-row { display: flex; justify-content: space-between; margin-bottom: 4px; }
    .chat-name { font-weight: 600; font-size: 16px; color: var(--neutral-foreground-rest); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .chat-time { font-size: 12px; color: var(--neutral-foreground-hint); }
    .chat-preview-row { display: flex; justify-content: space-between; align-items: center; font-size: 14px; color: var(--neutral-foreground-hint); }
    .unread-badge { background-color: var(--accent-fill-rest); color: white; font-size: 12px; padding: 2px 6px; border-radius: 10px; }

    /* selected chat*/
    .selected-chat-area { flex: 1; display: flex; flex-direction: column; height: 100%; }
    .chat-header-bar { padding: 10px 16px; background-color: var(--neutral-layer-1); border-bottom: 1px solid var(--neutral-stroke-rest); }
    
    .messages-container {
        flex: 1; padding: 16px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px;
        background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" opacity="0.05"><path d="M50,20 Q70,30 50,40 Q30,50 50,60 Q70,70 50,80 Q30,90 50,100" stroke="%23888" fill="none"/></svg>');
    }

    .message { max-width: 70%; padding: 8px 12px; border-radius: 8px; position: relative; word-wrap: break-word; }
    .my-message { align-self: flex-end; background-color: var(--accent-fill-rest); color: white; border-bottom-right-radius: 0; }
    .their-message { align-self: flex-start; background-color: var(--neutral-layer-3); color: var(--neutral-foreground-rest); border-bottom-left-radius: 0; }
    .message-time { font-size: 11px; opacity: 0.8; text-align: right; margin-top: 4px; display: flex; align-items: center; justify-content: flex-end; }
    .message-input-area { padding: 12px 16px; background-color: var(--neutral-layer-1); border-top: 1px solid var(--neutral-stroke-rest); }

    .no-chat-selected { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; background-color: var(--neutral-layer-2); padding: 20px; }
    .mobile-only { display: none; }
    .encryption-notice, .encryption-notice-welcome { text-align: center; font-size: 12px; color: var(--neutral-foreground-hint); display: flex; align-items: center; justify-content: center; gap: 6px; margin: 20px 0; }

    .bottom-nav-menu {
        background-color: var(--neutral-layer-1);
        border-top: 1px solid var(--neutral-stroke-divider-rest);
        width: 100%;
    }
    
    .nav-item {
        cursor: pointer;
        border-radius: 4px;
        padding: 4px;
        color: var(--neutral-foreground-hint);
        transition: 0.2s;
    }
    .nav-item:hover { background-color: var(--neutral-layer-3); }
    .nav-item.active { color: var(--accent-fill-rest); }
    .nav-item.active span { font-weight: 600; }

    @@media (max-width: 768px) {
        .chats-area { 
            width: 100%; 
            min-width: 100%;
            display: @(selectedChat == null ? "flex" : "none") !important; 
        }
        
        .main-content-area {
            display: @(selectedChat == null ? "none" : "flex") !important;
            width: 100%;
        }

        .mobile-only { display: block; }
    }
</style>