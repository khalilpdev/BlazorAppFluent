@page "/whatsapp"
@rendermode InteractiveServer

<PageTitle>WhatsApp</PageTitle>

<div class="whatsapp-container">
    <div class="chats-area">
        <div class="header">
            <FluentStack Horizontal Justify="Justify.Between" Align="Alignment.Center">
                <FluentText Weight="FontWeight.Semibold" Size="StandardFontSize.Large" Align="Align.Start">Chats</FluentText>
                <FluentStack Horizontal Gap="10px">
                    <FluentIcon Value="@searchIcon" />
                    <FluentIcon Value="@moreVerticalIcon" />
                </FluentStack>
            </FluentStack>
        </div>

        <div class="search-bar">
            <FluentTextField Placeholder="Ask Meta AI or Search" Style="width: 100%">
                <FluentIcon Value="@searchIcon" Slot="start" />
            </FluentTextField>
        </div>

        <div class="filter-tabs">
            <FluentTabs Orientation="Orientation.Horizontal">
                <FluentTab>All</FluentTab>
                <FluentTab>Unread</FluentTab>
                <FluentTab>Favorites</FluentTab>
                <FluentTab>Groups</FluentTab>
            </FluentTabs>
        </div>

        <div class="conversations-list">
            @foreach (var chat in chats)
            {
                <div class="chat-item @(chat.IsActive ? "active-chat" : "")" @onclick="@(() => SelectChat(chat))">
                    <div class="chat-content">
                        <div class="chat-avatar">
                            <div class="avatar-placeholder">
                                <FluentIcon Value="@personIcon" />
                            </div>
                        </div>
                        <div class="chat-details">
                            <div class="chat-header-row">
                                <span class="chat-name">@chat.Name</span>
                                <span class="chat-time">@chat.LastMessageTime</span>
                            </div>
                            <div class="chat-preview-row">
                                @if (chat.LastMessageType == MessageType.Text)
                                {
                                    <span class="message-preview">@chat.LastMessage</span>
                                }
                                else if (chat.LastMessageType == MessageType.Voice)
                                {
                                    <span class="message-preview">
                                        <FluentIcon Value="@micIcon" Style="margin-right: 4px; vertical-align: middle;" />
                                        Voice message
                                    </span>
                                }
                                else if (chat.LastMessageType == MessageType.Link)
                                {
                                    <span class="message-preview">
                                        <FluentIcon Value="@linkIcon" Style="margin-right: 4px; vertical-align: middle;" />
                                        @chat.LastMessage
                                    </span>
                                }

                                @if (chat.UnreadCount > 0)
                                {
                                    <span class="unread-badge">@chat.UnreadCount</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="bottom-nav-menu">
            <FluentStack Horizontal Justify="Justify.Around" Align="Alignment.Center" Style="width: 100%; padding: 8px 0;">
                <div class="nav-item @(activeTab == "chats" ? "active" : "")" @onclick="@(() => SetActiveTab("chats"))">
                    <FluentIcon Value="@chatIcon" Style="display: block; margin: 0 auto 4px;" />
                    <span style="font-size: 12px; text-align: center; display: block;">Chats</span>
                </div>
                <div class="nav-item @(activeTab == "status" ? "active" : "")" @onclick="@(() => SetActiveTab("status"))">
                    <FluentIcon Value="@statusIcon" Style="display: block; margin: 0 auto 4px;" />
                    <span style="font-size: 12px; text-align: center; display: block;">Status</span>
                </div>
                <div class="nav-item @(activeTab == "communities" ? "active" : "")" @onclick="@(() => SetActiveTab("communities"))">
                    <FluentIcon Value="@peopleIcon" Style="display: block; margin: 0 auto 4px;" />
                    <span style="font-size: 12px; text-align: center; display: block;">Communities</span>
                </div>
                <div class="nav-item @(activeTab == "calls" ? "active" : "")" @onclick="@(() => SetActiveTab("calls"))">
                    <FluentIcon Value="@callIcon" Style="display: block; margin: 0 auto 4px;" />
                    <span style="font-size: 12px; text-align: center; display: block;">Calls</span>
                </div>
            </FluentStack>
        </div>
    </div>

    <div class="main-content-area">
        @if (selectedChat != null)
        {
            <div class="selected-chat-area">
                <div class="chat-header-bar">
                    <FluentStack Horizontal Justify="Justify.Between" Align="Alignment.Center">
                        <FluentStack Horizontal Gap="10px" Align="Alignment.Center">
                            <FluentButton Appearance="Appearance.Stealth" OnClick="DeselectChat" Class="mobile-only">
                                <FluentIcon Value="@chevronLeftIcon" />
                            </FluentButton>
                            <div class="current-chat-info">
                                <FluentText Weight="FontWeight.Semibold">@selectedChat.Name</FluentText>
                                <FluentText Size="StandardFontSize.Small" Style="color: var(--neutral-foreground-rest);">Last seen recently</FluentText>
                            </div>
                        </FluentStack>
                        <FluentStack Horizontal Gap="10px">
                            <FluentIcon Value="@videoIcon" />
                            <FluentIcon Value="@callIcon" />
                            <FluentIcon Value="@moreVerticalIcon" />
                        </FluentStack>
                    </FluentStack>
                </div>

                <div class="messages-container">
                    <div class="encryption-notice">
                        <FluentIcon Value="@lockIcon" Style="margin-right: 4px; vertical-align: middle;" />
                        <span>Your personal messages are end-to-end encrypted</span>
                    </div>

                    @foreach (var message in selectedChat.Messages)
                    {
                        <div class="message @(message.IsMine ? "my-message" : "their-message")">
                            <div class="message-content">
                                @message.Content
                                <div class="message-time">
                                    @message.Time
                                    @if (message.IsMine)
                                    {
                                        <FluentIcon Value="@checkmarkIcon" Style="margin-left: 4px; vertical-align: middle;" />
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="message-input-area">
                    <FluentStack Horizontal Gap="10px" Align="Alignment.Center">
                        <FluentButton Appearance="Appearance.Stealth">
                            <FluentIcon Value="@emojiIcon" />
                        </FluentButton>
                        <FluentTextField Placeholder="Type a message" Style="flex: 1;">
                            <FluentIcon Value="@attachIcon" Slot="end" />
                        </FluentTextField>
                        <FluentButton Appearance="Appearance.Accent" Variant="Variant.Filled">
                            <FluentIcon Value="@micIcon" />
                        </FluentButton>
                    </FluentStack>
                </div>
            </div>
        }
        else
        {
            <div class="no-chat-selected">
                <div class="welcome-icon">
                    <FluentIcon Value="@chatIcon" Style="font-size: 48px; color: var(--neutral-foreground-rest); opacity: 0.5;" />
                </div>
                <FluentText Size="StandardFontSize.Medium" Style="color: var(--neutral-foreground-rest); margin-top: 20px;">
                    Select a chat to start messaging
                </FluentText>
                <div class="encryption-notice-welcome">
                    <FluentIcon Value="@lockIcon" Style="margin-right: 4px; vertical-align: middle;" />
                    <span>Your personal messages are end-to-end encrypted</span>
                </div>
            </div>
        }
    </div>
</div>

