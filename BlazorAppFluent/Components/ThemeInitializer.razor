@rendermode InteractiveServer
@inject IJSRuntime JS
@inject IDialogService DialogService

@code {
    private bool isSystemDarkMode = false;
    private bool dialogShown = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Check if user already has a saved preference
            // FluentDesignTheme uses "theme" as the storage key
            var savedTheme = await JS.InvokeAsync<string>("localStorage.getItem", "theme");
            
            if (string.IsNullOrEmpty(savedTheme))
            {
                // No saved preference, detect system theme and ask user
                isSystemDarkMode = await JS.InvokeAsync<bool>("getSystemTheme");
                
                // Show dialog after a small delay to ensure the component is rendered
                await Task.Delay(500);
                await ShowThemeDialog();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error detecting system theme: {ex.Message}");
            isSystemDarkMode = false;
        }
    }

    private async Task ShowThemeDialog()
    {
        if (dialogShown) return;
        dialogShown = true;

        var dialog = await DialogService.ShowDialogAsync<ThemeDialog>(
            new DialogParameters()
            {
                Title = "Theme Preference",
                PreventScroll = true,
                Alignment = HorizontalAlignment.Center,
                Width = "400px"
            });

        var result = await dialog.Result;
        if (!result.Cancelled && result.Data is bool isDarkMode)
        {
            await ApplyTheme(isDarkMode);
        }
    }

    private async Task ApplyTheme(bool isDarkMode)
    {
        try
        {
            // Store preference in localStorage using the same key as FluentDesignTheme
            // FluentDesignTheme expects a JSON object with mode and color
            var themeMode = isDarkMode ? "Dark" : "Light";
            var themeData = System.Text.Json.JsonSerializer.Serialize(new { Mode = themeMode });
            await JS.InvokeVoidAsync("localStorage.setItem", "theme", themeData);
            
            // Reload the page to apply the theme
            await JS.InvokeVoidAsync("location.reload");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error applying theme: {ex.Message}");
        }
    }
}
